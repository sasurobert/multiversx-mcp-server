{
    "buildInfo": {
        "contractCrate": {
            "name": "mpp-session-mvx",
            "version": "0.1.1"
        },
        "framework": {
            "name": "multiversx-sc",
            "version": "0.65.0"
        }
    },
    "name": "MppSessionContract",
    "constructor": {
        "inputs": [],
        "outputs": []
    },
    "upgradeConstructor": {
        "inputs": [],
        "outputs": []
    },
    "endpoints": [
        {
            "docs": [
                "Open a new payment session.",
                "Locks the payment sent in the transaction."
            ],
            "name": "open",
            "mutability": "mutable",
            "payableInTokens": [
                "*"
            ],
            "inputs": [
                {
                    "name": "receiver",
                    "type": "Address"
                },
                {
                    "name": "deadline",
                    "type": "u64"
                }
            ],
            "outputs": [
                {
                    "type": "bytes"
                }
            ]
        },
        {
            "name": "top_up",
            "mutability": "mutable",
            "payableInTokens": [
                "*"
            ],
            "inputs": [
                {
                    "name": "channel_id",
                    "type": "bytes"
                }
            ],
            "outputs": []
        },
        {
            "name": "settle",
            "mutability": "mutable",
            "inputs": [
                {
                    "name": "channel_id",
                    "type": "bytes"
                },
                {
                    "name": "amount",
                    "type": "BigUint"
                },
                {
                    "name": "nonce",
                    "type": "u64"
                },
                {
                    "name": "signature",
                    "type": "bytes"
                }
            ],
            "outputs": []
        },
        {
            "name": "close",
            "mutability": "mutable",
            "inputs": [
                {
                    "name": "channel_id",
                    "type": "bytes"
                },
                {
                    "name": "amount",
                    "type": "BigUint"
                },
                {
                    "name": "nonce",
                    "type": "u64"
                },
                {
                    "name": "signature",
                    "type": "bytes"
                }
            ],
            "outputs": []
        },
        {
            "name": "request_close",
            "mutability": "mutable",
            "inputs": [
                {
                    "name": "channel_id",
                    "type": "bytes"
                }
            ],
            "outputs": []
        },
        {
            "name": "getSession",
            "rustMethodName": "sessions",
            "mutability": "readonly",
            "inputs": [
                {
                    "name": "channel_id",
                    "type": "bytes"
                }
            ],
            "outputs": [
                {
                    "type": "SessionData"
                }
            ]
        }
    ],
    "events": [
        {
            "identifier": "open_session",
            "inputs": [
                {
                    "name": "channel_id",
                    "type": "bytes",
                    "indexed": true
                },
                {
                    "name": "employer",
                    "type": "Address",
                    "indexed": true
                },
                {
                    "name": "receiver",
                    "type": "Address",
                    "indexed": true
                },
                {
                    "name": "token_id",
                    "type": "EgldOrEsdtTokenIdentifier",
                    "indexed": true
                },
                {
                    "name": "amount",
                    "type": "BigUint"
                }
            ]
        },
        {
            "identifier": "settle_session",
            "inputs": [
                {
                    "name": "channel_id",
                    "type": "bytes",
                    "indexed": true
                },
                {
                    "name": "nonce",
                    "type": "u64",
                    "indexed": true
                },
                {
                    "name": "amount",
                    "type": "BigUint"
                }
            ]
        },
        {
            "identifier": "close_session",
            "inputs": [
                {
                    "name": "channel_id",
                    "type": "bytes",
                    "indexed": true
                },
                {
                    "name": "amount",
                    "type": "BigUint",
                    "indexed": true
                },
                {
                    "name": "refund_amount",
                    "type": "BigUint"
                }
            ]
        }
    ],
    "esdtAttributes": [],
    "hasCallback": false,
    "types": {
        "SessionData": {
            "type": "struct",
            "fields": [
                {
                    "name": "employer",
                    "type": "Address"
                },
                {
                    "name": "receiver",
                    "type": "Address"
                },
                {
                    "name": "token_id",
                    "type": "EgldOrEsdtTokenIdentifier"
                },
                {
                    "name": "amount_locked",
                    "type": "BigUint"
                },
                {
                    "name": "amount_settled",
                    "type": "BigUint"
                },
                {
                    "name": "deadline",
                    "type": "u64"
                },
                {
                    "name": "last_voucher_nonce",
                    "type": "u64"
                },
                {
                    "name": "status",
                    "type": "SessionStatus"
                }
            ]
        },
        "SessionStatus": {
            "type": "enum",
            "variants": [
                {
                    "name": "None",
                    "discriminant": 0
                },
                {
                    "name": "Open",
                    "discriminant": 1
                },
                {
                    "name": "Closed",
                    "discriminant": 2
                }
            ]
        }
    }
}
